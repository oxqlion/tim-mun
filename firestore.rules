rules_version = '2';

// Placeholder rules for the POC: all client reads/writes go through the FastAPI
// backend, which uses the Admin SDK and bypasses these rules entirely.
// Deny direct client access — the frontend never talks to Firestore directly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
