# JWT
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Firestore
# Local dev: point at the emulator, no credentials needed.
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_PROJECT_ID=agri-logistics-poc

# Real Firestore (production): unset FIRESTORE_EMULATOR_HOST and set this instead.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# CORS
CORS_ORIGINS=http://localhost:3000
